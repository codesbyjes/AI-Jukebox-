# Optional: when omitted, AIJukebox runs from the bundled real-tool catalog.
MONGODB_URI=mongodb://127.0.0.1:27017/aijukebox

# Optional: when omitted or unavailable, a conservative local task analyzer
# handles the built-in workflow categories for a fully runnable demo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

PORT=4000
CLIENT_ORIGIN=http://localhost:5173
